  saas_maturity_assessment: {
    id: 'saas_maturity_assessment',
    name: 'SaaS Maturity Assessment',
    description: 'Evaluate the SaaS delivery model maturity across tenant lifecycle, isolation, billing & metering, operations & analytics, and development governance',
    pillars: [
      'Tenant Lifecycle Management',
      'Tenant Isolation Management',
      'Billing & Metering',
      'Operations & Analytics',
      'Development Governance'
    ],
    questions: [
      {
        id: 'sma_tlm_001',
        title: 'How do you manage the end-to-end tenant lifecycle from onboarding to offboarding?',
        pillar: 'Tenant Lifecycle Management',
        bestPractices: [
          {
            id: 'sma_tlm_001_bp1',
            name: 'Fully automated, frictionless onboarding',
            description: 'Tenant onboarding is fully automated end-to-end with no human intervention. The process orchestrates a registration service that coordinates user management (identity provider setup, IAM policy creation), tenant management, billing integration, and async infrastructure provisioning. This applies to both B2B and B2C models — even internally triggered onboarding must be automated.'
          },
          {
            id: 'sma_tlm_001_bp2',
            name: 'Self-service or admin-triggered registration with unified experience',
            description: 'Tenants can register via a self-service page or an admin UI. The registration service acts as the central orchestrator, creating the tenant object, provisioning users in the identity provider, applying isolation policies, and triggering billing and infrastructure provisioning — all without manual steps.'
          },
          {
            id: 'sma_tlm_001_bp3',
            name: 'Tenant management service for lifecycle state and customization',
            description: 'A dedicated tenant management service maintains the state and attributes of each tenant (tier, status, feature flags) completely separate from user management. This enables per-tenant configuration (e.g., toggling features on/off) without forking the product or creating one-off environments.'
          },
          {
            id: 'sma_tlm_001_bp4',
            name: 'Billing integration wired into onboarding flow',
            description: 'Onboarding triggers a billing integration service that creates a customer profile with the billing provider, configures the tenant plan or tier, and stores payment details. A fault-tolerant, event-driven pattern (e.g., queuing billing events) ensures billing registration succeeds even if the billing provider is temporarily unavailable, avoiding impact on time-to-value.'
          },
          {
            id: 'sma_tlm_001_bp5',
            name: 'Automated offboarding with resource decommissioning',
            description: 'Tenant offboarding decommissions all associated infrastructure resources automatically (compute, storage, data). An updated inventory of per-tenant resources is maintained. Decommissioning is triggered via an approval workflow (e.g., ServiceNow), runs without impacting active tenants, and ensures data archiving or deletion meets SLA, audit, and compliance requirements before resources are removed.'
          },
          {
            id: 'sma_tlm_001_bp6',
            name: 'Full tenant lifecycle coverage including tier changes and suspension',
            description: 'The lifecycle management system handles all tenant state transitions: onboarding, tier upgrades/downgrades, suspension (e.g., non-payment), and full offboarding. Tier changes and suspension states are reflected consistently across the SaaS application and the billing provider. Automated testing validates each lifecycle transition to ensure expected behavior (SLAs, access controls, resource decommissioning) is enforced.'
          },
          {
            id: 'sma_tlm_001_bp7',
            name: 'Design for growth — onboarding scales without operational overhead',
            description: 'The onboarding architecture is designed to accommodate spikes in new tenant registrations without adding operational overhead or requiring manual intervention. The system scales frictionlessly, supporting rapid customer growth as a core SaaS agility tenet.'
          }
        ]
      },
      {
        id: 'sma_tim_001',
        title: 'How do you ensure tenant resources are protected from cross-tenant access?',
        pillar: 'Tenant Isolation Management',
        bestPractices: [
          {
            id: 'sma_tim_001_bp1',
            name: 'Isolation is non-optional and foundational',
            description: 'Tenant isolation is treated as a foundational, non-negotiable requirement of the SaaS architecture. Every system delivering a multi-tenant solution must implement measures to ensure tenant resources are isolated. The absence of a clear off-the-shelf solution does not justify lowering isolation requirements — custom isolation mechanisms must be built if needed.'
          },
          {
            id: 'sma_tim_001_bp2',
            name: 'Authentication and authorization are not sufficient for isolation',
            description: 'Passing authentication and authorization does not mean isolation is achieved. A user can be authenticated and authorized and still access another tenant\'s resources. Isolation is applied separately, using tenant context to scope and limit access to resources at runtime — independent of the auth layer.'
          },
          {
            id: 'sma_tim_001_bp3',
            name: 'Isolation enforcement is centralized and outside developer scope',
            description: 'Isolation rules are applied through a shared, centralized mechanism outside the view of individual service developers. Developers should not be expected to manually enforce isolation in every service. IAM policies, resource scoping, or policy-based controls are applied centrally to prevent unintentional cross-tenant boundary violations.'
          },
          {
            id: 'sma_tim_001_bp4',
            name: 'Tenant context propagated as a first-class construct across all layers',
            description: 'Tenant context (tenant ID, tier) is injected into the identity token (e.g., JWT custom claims) at authentication time and flows through all layers of the architecture — compute, storage, network, and microservices — without requiring additional service roundtrips. Every log entry, metric, and data access operation carries tenant context.'
          },
          {
            id: 'sma_tim_001_bp5',
            name: 'Isolation model (silo, pool, bridge) consistently applied and aligned to deployment',
            description: 'The chosen isolation model is consistently applied across all architecture layers. Silo models are valid when surrounded by shared control plane services (onboarding, metering, DevOps, analytics). Pool models require runtime policy-based isolation (e.g., IAM condition keys, fine-grained DynamoDB access) to compensate for shared infrastructure. Bridge models apply silo and pool strategies at the service or data layer level based on compliance and load profile.'
          },
          {
            id: 'sma_tim_001_bp6',
            name: 'Each service decomposed based on its isolation and load profile',
            description: 'Isolation strategy is evaluated per service, not applied uniformly across the entire system. Some services may pool data while others silo it based on compliance, noisy neighbor risk, or tiering requirements. Premium tier tenants may have specific services deployed in a silo model as part of their value proposition.'
          },
          {
            id: 'sma_tim_001_bp7',
            name: 'Noisy neighbor prevention through throttling and tier-based controls',
            description: 'Tenant resource consumption is throttled at the entry point (e.g., API Gateway usage plans per tier) to prevent any single tenant from degrading the experience of others. Tier-based isolation strategies ensure that premium tenants receive guaranteed SLAs, and automated testing validates that tenant boundaries hold under load.'
          },
          {
            id: 'sma_tim_001_bp8',
            name: 'Isolation continuously tested across the full tenant lifecycle',
            description: 'Isolation is validated through automated testing that covers cross-tenant access attempts, token spoofing, data partition boundary checks, and tenant lifecycle transitions (onboarding, tier change, suspension, offboarding). Tests verify that isolation holds at every layer — API, compute, storage — and that no tenant can access resources belonging to another tenant.'
          }
        ]
      },
      {
        id: 'sma_bm_001',
        title: 'How do you meter tenant consumption and connect it to billing?',
        pillar: 'Billing & Metering',
        bestPractices: [
          {
            id: 'sma_bm_001_bp1',
            name: 'Metering and metrics are distinct and purpose-built',
            description: 'Metering (used to generate bills) and metrics (used for operational analytics) are treated as separate concerns with different target destinations. Metering events are published to the billing provider. Metrics are published to analytics and observability tooling. Conflating the two leads to incorrect billing data or degraded operational insights.'
          },
          {
            id: 'sma_bm_001_bp2',
            name: 'Granular per-tenant consumption instrumentation',
            description: 'The application is instrumented to capture tenant activity and resource consumption at a granular level — compute, storage, data transfer, API calls, feature usage — tied to individual tenant identifiers. Instrumentation is introduced into microservices to capture detailed consumption events (e.g., TenantId, Method, ExecutionTime) published to an aggregation pipeline.'
          },
          {
            id: 'sma_bm_001_bp3',
            name: 'Billable unit defined in domain-relevant terms',
            description: 'Raw infrastructure metrics (CPU, memory, storage) are combined into a billable unit that makes sense to customers in the context of the SaaS domain (e.g., number of active users, number of transactions, data volume processed). The billable unit reflects the value delivered, not just infrastructure consumed.'
          },
          {
            id: 'sma_bm_001_bp4',
            name: 'Cost-per-tenant visibility to drive pricing and architecture decisions',
            description: 'Tenant consumption data is correlated with actual AWS infrastructure costs (via AWS Cost and Usage Reports or Cost Explorer API) to produce a cost-per-tenant view. This enables identification of unprofitable tiers (e.g., Basic tier tenants generating high infra costs relative to revenue), guides pricing and tiering strategy, and informs architectural optimization decisions.'
          },
          {
            id: 'sma_bm_001_bp5',
            name: 'Billing integration supports flexible models with fault tolerance',
            description: 'Billing data flows automatically to the billing provider via an event-driven, fault-tolerant pattern (e.g., event bus → billing aggregator → DynamoDB → scheduled batch to billing provider). This reduces the risk of hitting billing provider API limits, enables retries, and ensures billing registration does not block or delay tenant onboarding time-to-value.'
          },
          {
            id: 'sma_bm_001_bp6',
            name: 'Support for multiple billing models including usage-based and hybrid',
            description: 'The billing system supports subscription, usage-based, feature-based, user-based, and hybrid billing models. Tier changes, plan upgrades, and tenant suspension are reflected automatically in the billing provider and propagated back into the SaaS application without manual intervention.'
          },
          {
            id: 'sma_bm_001_bp7',
            name: 'Billing data retained for downstream analytics and cost optimization',
            description: 'Aggregated billing data is stored (e.g., in DynamoDB or S3) and made available for downstream analysis — enabling cost-per-tier, cost-per-feature, and cost-per-tenant breakdowns. This data drives iterative pricing refinement and architectural cost optimization over time.'
          }
        ]
      },
      {
        id: 'sma_oa_001',
        title: 'How do you monitor and manage the health and activity of tenants across your SaaS environment?',
        pillar: 'Operations & Analytics',
        bestPractices: [
          {
            id: 'sma_oa_001_bp1',
            name: 'Single-pane-of-glass tenant observability',
            description: 'A unified operational view exists across all tenants with tenant-aware logs, metrics, and dashboards. The operations dashboard surfaces health through the lens of individual tenants and tenant tiers — including most active tenants, resource consumption per tenant (compute, storage, bandwidth), and service activity. Global health views are complemented by per-tenant drill-down capabilities.'
          },
          {
            id: 'sma_oa_001_bp2',
            name: 'All telemetry carries tenant context',
            description: 'Every log entry, metric, and distributed trace emitted by the application includes tenant context (tenant ID, tier). This is the foundational requirement for tenant-aware observability. Without tenant context in telemetry, it is impossible to aggregate or disaggregate operational data by tenant or tier.'
          },
          {
            id: 'sma_oa_001_bp3',
            name: 'Proactive tenant health detection and self-healing',
            description: 'The system publishes tenant-aware health signals (latency, consumption anomalies, scaling signals) to a centralized data store. Alarms, policies, and automation are triggered based on aggregated health data to attempt self-healing before outages occur. Proactive identification of tenant-specific trends prevents issues from cascading across all tenants in a shared infrastructure model.'
          },
          {
            id: 'sma_oa_001_bp4',
            name: 'Tenant activity and consumption metrics actively tracked',
            description: 'Tenant activity and consumption patterns are continuously captured and analyzed to assess how tenants are using the application and imposing load on the system. This data is used to evaluate whether the system can effectively scale to support evolving tenant workloads, and to identify architectural bottlenecks or inefficiencies.'
          },
          {
            id: 'sma_oa_001_bp5',
            name: 'Business health metrics actively monitored',
            description: 'Key business health metrics are actively tracked: MRR (Monthly Recurring Revenue), churn rate, CAC (Customer Acquisition Cost), LTV (Lifetime Value), time-to-value for new tenants, and feature adoption rates. These metrics span business, operational, and architectural domains and are used by product, operations, and leadership to drive decisions.'
          },
          {
            id: 'sma_oa_001_bp6',
            name: 'Metrics enable time-to-value optimization and customer success',
            description: 'Onboarding activity is tracked per tenant to identify tenants with minimal or no engagement post-onboarding. This enables proactive customer success outreach to reduce churn risk and accelerate time-to-value. Metrics profiles are revisited over time as tenant consumption patterns evolve.'
          },
          {
            id: 'sma_oa_001_bp7',
            name: 'Per-tenant footprint visibility including sustainability metrics',
            description: 'Detailed dashboards provide per-tenant operational data across all layers of the solution: total compute (CPU, memory), data transfer, storage costs, and optionally carbon emission data. This creates a unified view of the per-tenant footprint that supports both operational optimization and sustainability reporting.'
          }
        ]
      },
      {
        id: 'sma_dg_001',
        title: 'How do you govern the development and deployment lifecycle across your multi-tenant SaaS environment?',
        pillar: 'Development Governance',
        bestPractices: [
          {
            id: 'sma_dg_001_bp1',
            name: 'CI/CD with zero-downtime, tenant-aware deployments',
            description: 'Deployment pipelines are fully automated with CI/CD, supporting zero-downtime deployments. Pipelines are tenant-aware and support canary, blue/green, and A/B release strategies to safely roll out changes without impacting active tenants. SaaS environments have no maintenance windows — the operational bar for deployments is significantly higher than traditional cloud applications.'
          },
          {
            id: 'sma_dg_001_bp2',
            name: '80% of development effort directed at net-new revenue-generating features',
            description: 'At least 80% of development effort is directed toward net-new revenue-generating features and functions. A high maintenance burden signals insufficient automation and technical debt that constrains SaaS agility and innovation velocity. This ratio is a key industry benchmark that directly influences company valuation and competitive positioning.'
          },
          {
            id: 'sma_dg_001_bp3',
            name: 'Feature flags for tenant-aware, dark-launch releases',
            description: 'Feature flags are used to deploy new capabilities to production in a "dark" state (disabled by default) and selectively enable them per tenant or tier at runtime. This eliminates the need for separate code branches or product versions, enables safe incremental rollouts, and supports per-tenant customization without forking the product.'
          },
          {
            id: 'sma_dg_001_bp4',
            name: 'Tiered deployment strategy with targeted tenant rollouts',
            description: 'Deployment pipelines support targeted rollouts to specific tenant groups or tiers. This enables canary releases to a subset of tenants before full rollout, tier-specific deployments (e.g., deploying to pooled tenants vs. siloed premium tenants), and controlled exposure of new features to early adopters.'
          },
          {
            id: 'sma_dg_001_bp5',
            name: 'Single unified version across all tenants',
            description: 'All tenants — whether in silo or pool deployment models — run the same version of the software at all times. One-off customizations are implemented as tenant configuration options (feature flags, tenant management service settings), not as separate product versions. This is the foundational principle that enables SaaS operational efficiency and agility.'
          },
          {
            id: 'sma_dg_001_bp6',
            name: 'Rapid release cadence aligned to SaaS agility goals',
            description: 'The release cadence targets multiple deployments per day or week, not quarterly releases. Rapid release cycles enable faster customer feedback loops, accelerate feature iteration, build customer loyalty, and create organic product promoters. Cycle time is actively measured and optimized as a core SaaS agility metric.'
          },
          {
            id: 'sma_dg_001_bp7',
            name: 'Microservice decomposition aligned to SaaS load, isolation, and deployment profiles',
            description: 'Services are decomposed based on their multi-tenant load profile, isolation requirements, fault isolation needs, and data partitioning strategy — not just business domain boundaries. Bulk operations, compliance-sensitive data, and tier-specific services are candidates for separate decomposition. Microservice boundaries are continuously evolved based on metrics data (call frequency, resource consumption, execution time).'
          }
        ]
      }
    ]
  }
};

export function getDomainConfig(domainId: string): DomainConfig | undefined {
  return DOMAIN_CONFIGURATIONS[domainId];
}

export function getAllDomains(): DomainConfig[] {
  return Object.values(DOMAIN_CONFIGURATIONS);
}